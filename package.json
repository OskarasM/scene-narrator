{
  "name": "scene-narrator",
  "version": "0.1.0",
  "description": "An accessibility layer for moving 3D scenes",
  "license": "MIT",
  "author": "Oskaras Margevicius",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/run.mjs",
    "bench:analyse": "node bench/analyse.mjs",
    "bench:serve": "node bench/serve.mjs",
    "prepublishOnly": "npm run check:prose && npm run build && npm test",
    "check:prose": "node scripts/check-prose.mjs"
  },
  "devDependencies": {
    "@guidepup/guidepup": "^0.33.2",
    "@guidepup/playwright": "^0.19.1",
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "@playwright/test": "^1.62.1",
    "@react-three/fiber": "^9.7.0",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "threejs",
    "react-three-fiber",
    "webgl",
    "screen-reader",
    "wcag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OskarasM/scene-narrator.git"
  },
  "homepage": "https://github.com/OskarasM/scene-narrator#readme",
  "bugs": {
    "url": "https://github.com/OskarasM/scene-narrator/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
